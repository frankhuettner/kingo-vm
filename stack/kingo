#!/usr/bin/env bash
# kingo — classroom stack helper.
# Works inside the VM (installed at /usr/local/bin/kingo) and on any host
# running the stack directly with Docker Desktop (./kingo ...).
set -euo pipefail

KINGO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
cd "$KINGO_DIR"

# shellcheck disable=SC1091
set -a; source ./.env; set +a

COMPOSE="docker compose"

# name|port|path ("tcp" = raw TCP check)
SERVICES=(
  "JupyterLab|8888|/api"
  "Jupyter MCP|4040|/"
  "Langflow|7860|/health"
  "n8n|5678|/healthz"
  "Metabase|3000|/api/health"
  "CloudBeaver|8978|/"
  "Qdrant|6333|/readyz"
  "PostgreSQL|5432|tcp"
)

check() { # port path -> 0 if up
  local port="$1" path="$2"
  if [ "$path" = "tcp" ]; then
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && { exec 3>&- 3<&-; return 0; } || return 1
  fi
  local code
  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:${port}${path}" 2>/dev/null || echo 000)
  [ "$code" != "000" ]
}

cmd_status() {
  local all_up=1
  printf '%-14s %-8s %s\n' "SERVICE" "STATUS" "URL"
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r name port path <<<"$s"
    if check "$port" "$path"; then st="up"; else st="DOWN"; all_up=0; fi
    printf '%-14s %-8s http://localhost:%s\n' "$name" "$st" "$port"
  done
  [ "$all_up" = 1 ] || { echo; echo "Something is down. Try: kingo restart   (details: kingo logs <service>)"; }
}

cmd_credentials() {
  cat <<EOF
Service        URL                              Login
-------        ---                              -----
JupyterLab     http://localhost:8888            no login required
Jupyter MCP    http://localhost:4040/mcp        Bearer token: ${MCP_TOKEN}
Langflow       http://localhost:7860            auto-login (classroom instance)
n8n            http://localhost:5678            create an account on first visit
Metabase       http://localhost:3000            ${METABASE_ADMIN_EMAIL} / ${KINGO_STRONG_PASSWORD}
CloudBeaver    http://localhost:8978            ${KINGO_USER} / ${KINGO_STRONG_PASSWORD}
Qdrant         http://localhost:6333/dashboard  no login required
PostgreSQL     localhost:5432                   ${KINGO_USER} / ${KINGO_PASSWORD}  (db: classroom)

VM console/SSH login: ${KINGO_USER} / ${KINGO_PASSWORD}   (ssh -p 2222 ${KINGO_USER}@localhost)
EOF
}

cmd_mcp() {
  echo "Jupyter MCP endpoint : http://localhost:4040/mcp"
  echo "Bearer token         : ${MCP_TOKEN}"
  echo
  echo "HTTP header for MCP clients:"
  echo "  Authorization: Bearer ${MCP_TOKEN}"
}

case "${1:-help}" in
  status)            cmd_status ;;
  credentials|creds) cmd_credentials ;;
  mcp)               cmd_mcp ;;
  logs)              shift; $COMPOSE logs --tail=100 -f "$@" ;;
  restart)           shift; $COMPOSE restart "$@" ;;
  start|up)          $COMPOSE up -d ;;
  stop|down)         $COMPOSE down ;;
  update)            git pull --ff-only 2>/dev/null || true
                     $COMPOSE pull && $COMPOSE up -d
                     echo "Stack updated." ;;
  reset)             echo "This DELETES all data (databases, notebooks, workflows) and starts fresh."
                     read -r -p "Type 'yes' to continue: " a
                     [ "$a" = "yes" ] && $COMPOSE down -v && $COMPOSE up -d ;;
  help|*)            cat <<'EOF'
kingo — classroom stack helper

  kingo status        show which services are up
  kingo credentials   print all URLs and logins
  kingo mcp           print the Jupyter MCP endpoint + bearer token
  kingo logs [svc]    follow logs (e.g. kingo logs langflow)
  kingo restart [svc] restart everything or one service
  kingo update        pull newer images and restart
  kingo reset         wipe all data and start fresh (asks first)
EOF
                     ;;
esac
