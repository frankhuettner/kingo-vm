[Unit]
Description=Kingo status banner on the VM console
After=kingo.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/local/bin/kingo-banner.sh
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
